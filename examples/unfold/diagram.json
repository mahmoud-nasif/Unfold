{
 "meta": {
  "title": "Unfold",
  "subtitle": "This repository, mapped by its own skill",
  "summary": "Unfold turns a codebase into a zoomable map: Claude reads the code in cheap stages, writes the diagram data, and a single HTML page lets anyone explore and edit it.",
  "glossary": [
   {
    "term": "Level",
    "def": "One diagram; a node can open into another"
   },
   {
    "term": "Scan",
    "def": "Cheap repo map: entry points, I/O, imports"
   },
   {
    "term": "Outline",
    "def": "Every function's signature, without its body"
   },
   {
    "term": "Peek",
    "def": "Reads only the lines around a reference"
   },
   {
    "term": "Engine",
    "def": "The HTML template that draws and edits"
   }
  ]
 },
